# College Connect Platform Environment Configuration

# Server Environment
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=college_connect_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
ANONYMOUS_SALT=cc_anon_salt_9284

# College Email Whitelist (Comma-separated)
WHITELISTED_DOMAINS=iiitbh.ac.in,college.edu

# Strict Quotas & Constraints
CAREER_ROOM_MEMBERSHIP_LIMIT=2
MESSAGE_LIMIT_CAREER=10
MESSAGE_LIMIT_CONNECT=10
ISSUE_LIMIT_DAILY=2
TIMEZONE=Asia/Kolkata

# Database Options:
# 1. Local Zero-Config Development (SQLite):
DATABASE_CLIENT=sqlite3
SQLITE_FILENAME=./data/college_connect.sqlite

# 2. Production / Docker Compose (PostgreSQL):
# DATABASE_CLIENT=pg
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/college_connect
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=college_connect
